@startuml
title Activity Diagram - Toàn bộ vòng đời đơn hàng

start

:Khách hàng đăng nhập;
:Hệ thống xác thực tài khoản;

:Khách hàng nhập thông tin giao hàng;
:Khách hàng nhập thông tin kiện hàng;
:Khách hàng gửi yêu cầu giao hàng;

:Hệ thống kiểm tra thông tin đơn hàng;

while (Thông tin không hợp lệ?) is (Có)
    :Thông báo lỗi;
    :Khách hàng chỉnh sửa thông tin;
    :Khách hàng gửi lại yêu cầu;
    :Hệ thống kiểm tra lại thông tin;
endwhile (Không)

:Tạo đơn hàng;
:Cập nhật trạng thái PENDING;

:Dispatcher kiểm tra yêu cầu giao hàng;

if (Duyệt đơn?) then (Có)

    :Cập nhật trạng thái APPROVED;
    :Dispatcher lên lịch giao hàng;
    :Phân công Drone và trạm hạ cánh;
    :Cập nhật trạng thái ASSIGNED;

    :Nhân viên trạm chuẩn bị kiện hàng;
    :Xác nhận Pickup;

    :Bắt đầu chuyến giao hàng;
    :Cập nhật trạng thái IN_TRANSIT;

    :Theo dõi quá trình giao hàng;
    :Cập nhật vị trí và ETA;

    if (Giao hàng thành công?) then (Có)

        :Xác nhận giao hàng;
        :Cập nhật trạng thái DELIVERED;
        :Gửi thông báo hoàn tất;
        stop

    else (Không)

        :Ghi nhận giao hàng thất bại;
        :Chuyển sang quy trình xử lý giao hàng thất bại;
        stop

    endif

else (Không)

    :Dispatcher nhập lý do từ chối;
    :Cập nhật trạng thái CANCELLED;
    :Gửi thông báo từ chối cho khách hàng;
    stop

endif
@enduml
